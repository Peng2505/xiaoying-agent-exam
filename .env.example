# 复制为 .env 后填写。.env 已被 .gitignore 排除，不要提交真实密钥。

# OpenAI 兼容接口（默认 DeepSeek）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 非思考模式：disabled（推荐，配合 Tool Calling）；enabled 需回传 reasoning_content
LLM_THINKING=disabled

# 单次会话最大执行步数（每次 LLM 动作计 1 步）
MAX_STEPS=12

# 单个步骤最多真实执行次数，超过后记为 RETRY_EXHAUSTED
MAX_ATTEMPTS_PER_STEP=3

# 跨续跑会话的累计决策步上限（防止反复新建 step_id 绕过单步重试上限）
MAX_CUMULATIVE_STEPS=36

# 可选：覆盖数据目录与运行产物目录
# CONTENT_AGENT_DATA_DIR=./data
# CONTENT_AGENT_RUNS_DIR=./runs
# CONTENT_AGENT_PLANS_DIR=./saved_plans
